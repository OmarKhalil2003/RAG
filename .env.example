# ==========================================
# Arabic Legal RAG PoC Configuration
# ==========================================

# LLM Configuration
# Set LLM_PROVIDER to 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Qdrant Vector Database
# Set QDRANT_URL to http://localhost:6333 if running via Docker
# Leave blank or specify QDRANT_STORAGE_PATH to use local embedded storage without Docker
QDRANT_URL=http://localhost:6333
QDRANT_STORAGE_PATH=data/qdrant_db

# Redis Semantic Cache
REDIS_URL=redis://localhost:6379/0
# Cosine distance threshold: lower = stricter similarity (0.00 - 2.00)
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.08
SEMANTIC_CACHE_TTL=3600

# Legal Knowledge Base & Prompt Versioning
KNOWLEDGE_BASE_VERSION=v1
PROMPT_VERSION=v1

# Development Mode (enables local test cache if Redis is offline)
LOCAL_DEV_MODE=false
